{
  "properties": {
    "description": "Land every batch source unchanged into lh_bronze Files/landing/<system>/<run id>/, then build Bronze. IDs are placeholders resolved by parameter.yml at deploy (U19).",
    "activities": [
      {
        "name": "copy_billing_patient_account",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60
        },
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "datasetSettings": {
              "type": "AzureSqlTable",
              "typeProperties": {
                "schema": "billing",
                "table": "patient_account"
              },
              "externalReferences": {
                "connection": "00000000-0000-0000-0000-000000000000"
              }
            }
          },
          "sink": {
            "type": "ParquetSink",
            "storeSettings": {
              "type": "LakehouseWriteSettings"
            },
            "formatSettings": {
              "type": "ParquetWriteSettings"
            },
            "datasetSettings": {
              "type": "Parquet",
              "linkedService": {
                "name": "lh_bronze",
                "properties": {
                  "type": "Lakehouse",
                  "typeProperties": {
                    "artifactId": "00000000-0000-0000-0000-000000000000",
                    "workspaceId": "00000000-0000-0000-0000-000000000000",
                    "rootFolder": "Files"
                  }
                }
              },
              "typeProperties": {
                "location": {
                  "type": "LakehouseLocation",
                  "folderPath": {
                    "value": "@concat('landing/billing/', pipeline().RunId)",
                    "type": "Expression"
                  },
                  "fileName": "patient_account.parquet"
                }
              }
            }
          }
        }
      },
