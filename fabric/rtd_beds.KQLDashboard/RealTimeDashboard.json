        "kind": "inline",
        "dataSourceId": "a9e87016-45be-4c82-8b04-d13924ab74a9"
      },
      "text": "adt_event\n| top 1 by ingested_at desc\n| project event_id, event_type, event_time, ingested_at, lag_s = datetime_diff('second', now(), ingested_at)",
