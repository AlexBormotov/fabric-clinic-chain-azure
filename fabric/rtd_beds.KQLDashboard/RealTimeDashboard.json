        "kind": "inline",
        "dataSourceId": "a9e87016-45be-4c82-8b04-d13924ab74a9"
      },
      "text": "ward_occupancy()\n| project clinic_name, ward_name, occupied_beds, beds, occupancy\n| order by occupancy desc, clinic_name asc, ward_name asc",
      "usedVariables": []
    },
    {
      "id": "22c85044-b86a-4ab4-9ea3-7eee63c53408",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "a9e87016-45be-4c82-8b04-d13924ab74a9"
      },
      "text": "bed\n| join kind=leftouter (bed_current()) on bed_id\n| project clinic_name, ward_name, bed_id, state = iff(occupied == true, \"occupied\", \"free\"), stay_id, since\n| order by clinic_name asc, ward_name asc, bed_id asc",
      "usedVariables": []
    },
    {
