# Every environment variable the project reads, without values. Copy to .env (git-ignored).
# Variables are added by the units that introduce them.

# Local SQL Server SA password (U04); `make up` generates .env with a random one if it is missing.
MSSQL_SA_PASSWORD=

# ADT replay target (U11): an Eventstream custom endpoint connection string (with EntityPath).
# Empty means the local Event Hubs emulator.
ADT_EVENTHUB_CONNECTION_STRING=
