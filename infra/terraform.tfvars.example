# Copy to terraform.tfvars (git-ignored). IDs and names only; there is no secret to put here.

subscription_id = "00000000-0000-0000-0000-000000000000"
owner_upn       = "owner@example.onmicrosoft.com"

# The owner's public IPv4 address, for loading the billing database.
client_ip_addresses = ["203.0.113.10"]

# Optional; null skips the piece.
# git_connection_id     = "00000000-0000-0000-0000-000000000000"
# deployer_principal_id = "00000000-0000-0000-0000-000000000000"
# phi_reader_group_id   = "00000000-0000-0000-0000-000000000000"

# Paid while it runs: the F2 the workspaces run on. Without it, name an existing capacity.
enable_f2 = true
# fabric_capacity_name = "my-capacity"
