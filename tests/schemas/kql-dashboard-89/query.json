{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "/static/d/schema/89/query.json",
    "meta": { "schema_version": 89, "json_filename": "query.json" },
    "title": "Query schema",
    "type": "object",
    "properties": {
        "query": {
            "type": "object",
            "properties": {
                "id": { "$ref": "dashboard.json#/$defs/uuid" },
                "dataSource": {
                    "oneOf": [
                        {
                            "type": "object",
                            "properties": {
                                "kind": { "const": "inline" },
                                "dataSourceId": { "$ref": "dashboard.json#/$defs/uuid" }
                            },
                            "required": ["kind", "dataSourceId"]
                        },
                        {
                            "type": "object",
                            "properties": {
                                "kind": { "const": "parameter" },
                                "parameterId": { "$ref": "dashboard.json#/$defs/uuid" }
                            },
                            "required": ["kind", "parameterId"]
                        }
                    ]
                },
                "usedVariables": {
                    "type": "array",
                    "description": "An array of strings containing the variable names. Can be empty.",
                    "uniqueItems": true,
                    "items": { "$ref": "dashboard.json#/$defs/variableName" },
                    "examples": [[], ["startTime", "endTime"]],
                    "errorMessage": { "type": "Expected to be an array of strings" }
                },
                "text": {
                    "type": "string",
                    "description": "The kusto query used to populate this parameter with values",
                    "errorMessage": { "type": "Expected to be a string" },
                    "examples": ["let randomSet = materialize(range x from 5 to 15 step 1 \n| project x);\nrandomSet\n"]
                }
            },
            "required": ["id", "usedVariables", "text"]
        }
    },
    "$defs": {
        "queryRef": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": { "kind": { "const": "query" }, "queryId": { "$ref": "dashboard.json#/$defs/uuid" } },
                    "required": ["kind", "queryId"]
                },
                {
                    "type": "object",
                    "properties": {
                        "kind": { "const": "baseQuery" },
                        "baseQueryId": { "$ref": "dashboard.json#/$defs/uuid" }
                    },
                    "required": ["kind", "baseQueryId"]
                }
            ]
        }
    }
}
